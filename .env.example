# Runtime database connection for Vercel (Supabase transaction pooler)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres"

# Migration connection (Supabase direct connection or session pooler)
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# Auth.js
AUTH_SECRET="generate-with-openssl-rand-base64-33"
AUTH_GOOGLE_ID="google-oauth-client-id"
AUTH_GOOGLE_SECRET="google-oauth-client-secret"

# Optional on Vercel because Auth.js normally infers the host
AUTH_URL="https://your-production-domain.example"
