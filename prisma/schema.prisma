generator client {
 provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Essay {
   id   String @id @default(cuid())
   taskId String
   content String
   aiResponse String?
   createdAt DateTime @default(now())
}

model User {
 id    Int     @id @default(autoincrement())
 email String  @unique
 name  String?
 posts Post[]
}

model Post {
 id        Int     @id @default(autoincrement())
 title     String
 content   String?
 published Boolean @default(false)
 author    User    @relation(fields: [authorId], references: [id])
 authorId  Int
}